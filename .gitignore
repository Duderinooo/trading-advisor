# Environment and secrets
.env

# Python
__pycache__/
*.py[cod]
venv/
.venv/

# MemPalace data (local, wird auf neuem Rechner neu erstellt)
.palace/

# API usage tracking (local state)
.api_usage.json

# Lang & Schwarz instrument-id cache (regenerated on first lookup)
.ls_tc_ids.json

# Private portfolio holdings (should stay out of git)
portfolio.json
.portfolio_*.json

# Logs
*.log
*.log.*
*.err
trading.log

# Gate-decision JSONL log (rotated locally, regenerated each run)
gate_blocks.jsonl
gate_blocks.jsonl.*

# Claude call audit (regenerated each run, contains full system prompts)
claude_calls.jsonl
.system_prompts/

# Backtest report (regenerated by `python -m core.backtest --write`)
backtest_report.json

# Analytics (gate-outcome counterfactuals + daily snapshots, runtime-generated).
# Anchored to bot/ — web/ has a route called /api/analytics that is source code
# and MUST be tracked.
/bot/analytics/

# Historical bar cache (regenerated from yfinance on demand)
/bot/data_cache/

# Decomposed portfolio state (dedup, traces, runtime — runtime-generated)
/bot/state/

# IDE
.vscode/
.idea/

# macOS
.DS_Store
